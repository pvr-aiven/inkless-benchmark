# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# ── Aiven ────────────────────────────────────────────────────────────────────
AIVEN_TOKEN=your_aiven_api_token_here

# ── Terraform variable passthrough ───────────────────────────────────────────
# These are picked up by the Terraform wrapper in the Makefile via TF_VAR_*
TF_VAR_aiven_token=${AIVEN_TOKEN}
TF_VAR_aiven_project=my-aiven-project
TF_VAR_custom_cloud_name=byoc-gcp-europe-west1-xxxxxxxx
TF_VAR_service_name=inkless-benchmark
TF_VAR_kafka_plan=business-8-inkless
