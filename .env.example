# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# ── Aiven ────────────────────────────────────────────────────────────────────
AIVEN_TOKEN=your_aiven_api_token_here

# ── Terraform variable passthrough ───────────────────────────────────────────
# These are picked up by the Makefile via TF_VAR_* and passed to terraform apply
TF_VAR_aiven_token=${AIVEN_TOKEN}
TF_VAR_aiven_project=my-aiven-project
TF_VAR_cloud_name=google-europe-west1
TF_VAR_service_name=inkless-benchmark
TF_VAR_kafka_plan=inkless-professional-3x-8-1
