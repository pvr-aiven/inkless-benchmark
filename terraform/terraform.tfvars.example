# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit secrets.

aiven_project = "my-aiven-project"
cloud_name    = "google-europe-west1"
service_name  = "inkless-benchmark"

# Initial plan provisioned by Terraform.
# The benchmark runner handles upgrade/downgrade — change this only if you want
# to start from a different plan tier.
kafka_plan    = "inkless-professional-3x-8-1"
kafka_version = "4.1"

topic_name        = "inkless-benchmark-topic"
topic_partitions  = 6
topic_replication = 3

benchmark_username = "benchmark-user"
